{
  "_doc": [
    "One entry per logical series the Mexico macro page uses. The fetcher tries each",
    "candidate in order and keeps the first one that (a) answers, (b) carries the",
    "expected title (regex, case-insensitive, checked against the provider's own",
    "metadata) and (c) returns enough points. A candidate whose title does not match",
    "is dropped and reported, so a mistyped ID can never put a wrongly-labelled",
    "series on the page. Providers: banxico (SIE API, token), fred (St. Louis Fed,",
    "key optional; without a key the CSV export is used and the title is not checked",
    "because the export carries none), inegi (Indicadores API, token; no title",
    "metadata in its response, so only use it for IDs already confirmed in the",
    "INEGI catalog and set title to null)."
  ],
  "series": {
    "inpc":            { "freq": "M", "unit": "index", "since": "2010-01-01", "candidates": [
      { "provider": "banxico", "id": "SP1",     "title": "^(?!.*subyacente).*(precios al consumidor|INPC|(í|i)ndice general)" },
      { "provider": "fred",    "id": "MEXCPIALLMINMEI", "title": "consumer price.*mexico" } ] },
    "inpcCore":        { "freq": "M", "unit": "index", "since": "2010-01-01", "candidates": [
      { "provider": "banxico", "id": "SP74625", "title": "^(?!.*no subyacente).*subyacente" },
      { "provider": "fred",    "id": "MEXCPICORMINMEI", "title": "consumer price.*(non-food|excluding).*mexico|all items less food and energy.*mexico", "note": "OECD definition (all items less food and energy), not INEGI's subyacente" } ] },
    "inpcNonCore":     { "freq": "M", "unit": "index", "since": "2010-01-01", "candidates": [
