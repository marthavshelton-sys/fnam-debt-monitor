    transform: translateY(0);
  }

  .carousel-arrows .owl-nav .owl-prev:before,
  .carousel-arrows .owl-nav .owl-next:before {
    font-size: 30px;*/
    }


    .carrusel-container {
        display: flex;
        width: 100%;
        height: auto;
        max-height: 40vh;
        /* Máximo 40% de la altura de la ventana */
    }

    .carrusel-imagen {
        border-radius: 5px;
        position: relative;
        width: 80%;
        /* 80% del ancho total */
    }

    .imagen img {
        width: 100%;
        /* Ajusta el tamaño según el contenedor */
        max-height: 100%;
        /* Limita la altura de las imágenes al 100% del contenedor */
        object-fit: cover;
        /* Mantiene la proporción sin deformarse */
        border-radius: 5px;
    }

    .texto-carrusel {
        position: absolute;
        bottom: 10%;
        /* Ajusta la posición del texto */
        left: 5%;
        /* Ajusta la posición del texto */
        color: white;
        /* Cambia el color según tu diseño */
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
        /* Mejora la legibilidad */
    }

    .botones {
        position: absolute;
        top: 50%;
        width: 100%;
        display: flex;
        justify-content: space-between;
        /* Coloca los botones en los extremos izquierdo y derecho */
        transform: translateY(-50%);
        opacity: 0;
        /* Oculta los botones inicialmente */
        transition: opacity 0.3s ease;
        /* Transición suave para mostrar/ocultar */
    }

    .boton-prev,
    .boton-next {
        background: rgba(0, 0, 0, 0);
        /* Fondo semitransparente */
        color: white;
        border: none;
        padding: 20px;
        /* Aumenta el padding para hacer los botones más grandes */
        font-size: 24px;
        /* Aumenta el tamaño de la fuente */
        cursor: pointer;
        border-radius: 10px;
        /* Ajusta el radio de los bordes */
        width: 50px;
        /* Aumenta el ancho del botón */
        height: 50px;
        /* Aumenta la altura del botón */
    }


    .carrusel-imagen:hover .botones {
        opacity: 1;
        /* Muestra los botones al hacer hover en el carrusel */
    }

    .boton-prev {
        margin-left: 10px;
        /* Separación del borde izquierdo */
    }

    .boton-next {
        margin-right: 10px;
        /* Separación del borde derecho */
    }

    .carrusel-vertical {
        display: flex;
        flex-direction: column;
        margin-left: 20px;
        width: 20%;
        /* 20% del ancho total */
        max-height: 40vh;
        /* Limita la altura máxima del contenedor al 40% de la ventana */
        overflow-y: auto;
        /* Habilita el scroll en caso de que las imágenes excedan el contenedor */
    }

    .imagen-vertical {
        position: relative;
        margin-bottom: 10px;
        /* Espaciado entre las imágenes del carrusel vertical */
        cursor: pointer;
        text-align: center;
        height: calc(40vh / 5 - 10px);
        /* Divide el alto máximo entre 5 imágenes */
        border-radius: 5px;
    }

    .imagen-vertical img {
        width: 100%;
        /* Ajusta el ancho de las imágenes al contenedor */
        height: 100%;
        /* Hace que la imagen llene el espacio disponible */
        object-fit: cover;
        /* Mantiene la proporción de la imagen sin deformarse */
        opacity: 0.5;
        transition: opacity 0.3s ease;
        border-radius: 5px;
    }

    .imagen-vertical img:hover {
        opacity: 1;
    }

    .imagen-vertical h3 {
        position: absolute;
        /* Posiciona el título sobre la imagen */
        top: 10%;
        /* Ajusta la posición superior */
        left: 50%;
        transform: translateX(-50%);
        color: white;
        /* Color del título */
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
        /* Mejora la legibilidad */
    }

    .carrusel-imagen .imagen {
        transition: opacity 0.5s ease-in-out;
        /* Suaviza la transición de opacidad */
        opacity: 0;
        /* Oculta la imagen inicialmente */
    }

    .carrusel-imagen .imagen img {
        width: 100%;
        /* Asegura que ocupe todo el ancho del contenedor */
        height: 100%;
        /* Establece la altura al 100% del contenedor */
        object-fit: cover;
        /* Asegura que la imagen cubra todo el contenedor sin deformarse */
        max-height: 40vh;
        /* Asegura que la imagen no exceda el 40% de la altura de la ventana */
    }

    .titulo-formal {
        font-family: 'Georgia', serif;
        /* Cambia a una fuente serif para un estilo más formal */
        font-size: 34px;
        /* Tamaño de fuente adecuado para títulos */
        font-weight: bold;
        /* Negrita para destacar el título */
        color: white;
        /* Color oscuro para buena legibilidad */
        margin-bottom: 8px;
        /* Espacio debajo del título */
    }

    .titulo-formal-vertial {
        font-family: 'Georgia', serif;
        /* Cambia a una fuente serif para un estilo más formal */
        font-size: 15px !important;
        /* Tamaño de fuente adecuado para títulos */
        font-weight: bold;
        /* Negrita para destacar el título */
        color: white;
        /* Color oscuro para buena legibilidad */
        margin-bottom: 8px;
        /* Espacio debajo del título */
    }

    .resumen-formal {
        font-family: 'Arial', sans-serif;
        /* Fuente sans-serif para una apariencia limpia */
        font-size: 26px;
        /* Tamaño de fuente adecuado para resúmenes */
        color: white;
        /* Color gris para un contraste suave */
        line-height: 1.5;
        /* Mejora la legibilidad del texto */
    }

    .video .heading__title {
        font-weight: 700;
    }

    .video ::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: url('https://www.aifa.aero/Rm1wZXpOSWJaVkRBOXlOeDc0N0VEdz09/imagen.jpg');
        background-size: cover;
        opacity: 1.5;
        /* Solo afecta la imagen */
        z-index: -1;
        /* Mantiene el fondo detrás del contenido */
    }

    .fm-icon:hover .fm-label {
        opacity: 1 !important;
    }

    .infodato {
        align-content: center;
        align-items: center;
        text-align: center;
    }

    .infodato .counter {
        font-size: clamp(2rem, 2.2rem, 2.8rem);
    }



    /*=============================*/

    @media screen and (max-width: 500px) {
        .social__icons {
            padding-left: 14px;
        }

        .footer-top {
            padding-top: 1px !important;
        }

        .footer__widget {
            margin-bottom: 0px !important;
        }

        .footer-bottom {
            padding-top: 20px !important;
            padding-bottom: 50px !important;
        }

        .footer__copyright p {
            font-size: 10px !important;
        }
    }

    #video1 {
        position: relative;
        overflow: hidden;
        width: 100%;
        /*min-height: 100vh;*/
    }

    .bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    /*.bg-video::after {
        content: '';
