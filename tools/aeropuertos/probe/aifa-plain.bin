</script>    <script>
document.addEventListener('DOMContentLoaded', function() {
    // Seleccionamos todos los contenedores de cards
    const cards = document.querySelectorAll('.card-container');
    
    // Configuramos el Intersection Observer
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // Cuando la card entre en el viewport
                entry.target.style.visibility = 'visible'; // Aseguramos que es visible
                // Pequeño delay para asegurar una transición suave
                setTimeout(() => {
                    entry.target.classList.add('show');
                }, 100);
                // Dejamos de observar una vez que se ha mostrado
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.1, // La animación comenzará cuando el 10% de la card sea visible
        rootMargin: '0px 0px -50px 0px' // Ajusta el punto de activación
    });
    
    // Comenzamos a observar cada card
    cards.forEach(card => {
        observer.observe(card);
    });
});
</script>    <script>
document.addEventListener('DOMContentLoaded', () => {
    const slider = document.querySelector('.slider_aifa');
    const slides = document.querySelectorAll('.slide_aifa');
    const prevButton = document.querySelector('.prev_aifa');
    const nextButton = document.querySelector('.next_aifa');

    let isDragging = false;
    let startX;
    let startScrollLeft;
    let currentIndex = 0;

    // Calculate slide width considering gaps
    function getSlideWidth() {
        const firstSlide = slides[0];
        const slideWidth = firstSlide.getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(slider).gap) || 20;
        return slideWidth + gap;
    }

    // Update slider position
    function updateSlider() {
        const slideWidth = getSlideWidth();
        slider.scrollTo({
            left: slideWidth * currentIndex,
            behavior: 'smooth'
        });
    }

    // Navigation functions
    function nextSlide() {
        const maxIndex = window.innerWidth <= 768 ? slides.length - 1 : slides.length - 3;
        currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
        updateSlider();
    }

    function prevSlide() {
        const maxIndex = window.innerWidth <= 768 ? slides.length - 1 : slides.length - 3;
        currentIndex = currentIndex > 0 ? currentIndex - 1 : maxIndex;
        updateSlider();
    }

    // Drag interaction
    function startDragging(e) {
        isDragging = true;
        slider.classList.add('dragging_aifa');
        startX = e.pageX - slider.offsetLeft;
        startScrollLeft = slider.scrollLeft;
    }

    function stopDragging() {
        isDragging = false;
        slider.classList.remove('dragging_aifa');
        
        // Snap to nearest slide
        const slideWidth = getSlideWidth();
        currentIndex = Math.round(slider.scrollLeft / slideWidth);
        updateSlider();
    }

    function drag(e) {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - slider.offsetLeft;
        const walk = (x - startX) * 2; // Multiplier for faster/slower drag
        slider.scrollLeft = startScrollLeft - walk;
    }

    // Event Listeners
    prevButton.addEventListener('click', prevSlide);
    nextButton.addEventListener('click', nextSlide);

    // Drag events
    slider.addEventListener('mousedown', startDragging);
    slider.addEventListener('mouseleave', stopDragging);
    slider.addEventListener('mouseup', stopDragging);
    slider.addEventListener('mousemove', drag);

    // Touch events for mobile
    slider.addEventListener('touchstart', (e) => {
        startDragging(e.touches[0]);
    }, { passive: false });

    slider.addEventListener('touchmove', (e) => {
        drag(e.touches[0]);
    }, { passive: false });

    slider.addEventListener('touchend', stopDragging);

    // Auto-slide
    let autoSlideInterval = setInterval(nextSlide, 4000);

    slider.addEventListener('mouseenter', () => {
        clearInterval(autoSlideInterval);
    });

    slider.addEventListener('mouseleave', () => {
        autoSlideInterval = setInterval(nextSlide, 4000);
    });

    // Resize handler
    window.addEventListener('resize', updateSlider);
});
</script>    <script>
