    <section id="cta1" class="cta cta-1 border-top pt-0 pb-0">
            <div class="vuelo-banner">
        <div class="">
            <div class="vuelo-banner-title"><i class="plane"><img src="assets/icons/Todos-los-vuelos-02.png"
                        width="40" alt=""></i>
                Localizador de vuelos
            </div>
        </div>
        <div class="vuelo-search-container">
            <div class="">
                <fieldset class="vuelo-transport-buttons">
                    <legend >Seleccione el tipo de vuelo: Llegadas o Salidas</legend>
                    <input type="radio" class="vuelo-transport-option" name="tipo" value="arrivals" id="arrivals">
                    <label class="vuelo-transport-label" for="arrivals"> <i class="plane-arrival"><img
                                src="/Rm1wZXpOSWJaVkRBOXlOeDc0N0VEdz09/HTMLs/modulos/assets/icons/Llegadas-07.png" alt=""></i>
                        <span>LLEGADAS</span> </label>
                    <input type="radio" class="vuelo-transport-option" name="tipo" value="departures" id="departures">
                    <label class="vuelo-transport-label" for="departures"> <i class="plane-departure"><img
                                src="/Rm1wZXpOSWJaVkRBOXlOeDc0N0VEdz09/HTMLs/modulos/assets/icons/Salidas-07.png" alt=""></i>
                        <span>SALIDAS</span> </label>
                    <input type="radio" class="vuelo-transport-option" name="tipo" value="all" id="all"
                        checked="checked">
                    <label class="vuelo-transport-label" for="all"> <i class="plane"><img
                                src="/Rm1wZXpOSWJaVkRBOXlOeDc0N0VEdz09/HTMLs/modulos/assets/icons/Todos-los-vuelos-07.png" alt=""></i>
                        <span>TODOS</span> </label>
                </fieldset>
                <div class="vuelo-search-row">
                    <div class="row">
                        <div class="col-sm-12 col-md-8 col-lg-8">
                            <input id="numerovuelo" type="text" class="vuelo-form-control"
                                placeholder="Número de vuelo" aria-label="Número de vuelo">
                        </div>
                        <div class="col-sm-12 col-md-4 col-lg-4 text-center text-md-end">
                            <button type="button" class="vuelo-btn__primary btn__hover3 w-100"
                                onclick="location='/vuelos/'+$('input[name=\'tipo\']:checked').val()+'/'+$('#numerovuelo').val()">Buscar Vuelo</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </section>
