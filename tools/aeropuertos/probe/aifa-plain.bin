</script>    <script>

            // Variables para controlar el tamaño de fuente
            let currentFontLevel = 0; // 0 = normal, positivo = más grande, negativo = más pequeño
            const maxFontLevel = 3;
            const minFontLevel = -2;
            const fontStep = 0.1; // 10% de incremento/decremento
            const fontLevels = new Map([
               [-2, 12],
               [-1, 13.5],
               [0, 15],
               [1, 16.5],
               [2, 18],
               [3, 19.5],
            ]);

            // Elementos que se van a escalar
            const textElements = 'body, p, li, span, a, button, input, textarea, label, td, th, div';
            const headingElements = 'h1, h2, h3, h4, h5, h6';

            // Elementos excluidos (no se escalarán)
            const excludedSelectors = 'ul.dropdown-menu *, ul.nav.flex-column *';

            // Función para actualizar el indicador
            function updateIndicator() {
                let indicatorText = '';
                if (currentFontLevel === 0) {
                    indicatorText = 'Normal';
                } else if (currentFontLevel > 0) {
                    indicatorText = 'Grande ' + ` +${currentFontLevel}`;
                } else {
                    indicatorText = 'Pequeño ' + ` ${currentFontLevel}`;
                }
                $('#font-indicator').text(indicatorText);
            }

            // Función para aplicar el cambio de tamaño
            function applyFontSize() {
                const root = document.documentElement;
                root.style.setProperty('--body-font-size', `${fontLevels.get(currentFontLevel)}px`);

                // Guardar preferencia en localStorage (si está disponible)
                try {
                    localStorage.setItem('airport-font-level', currentFontLevel);
                } catch(e) {
                    // localStorage no disponible, continuar sin guardar
                }

                updateIndicator();

                // Re-check nav overflow after the CSS variable reflows
                requestAnimationFrame(() => {
                    console.log(typeof checkTextOverflow);
                    if (typeof checkTextOverflow === 'function') checkTextOverflow();
                });
            }

            // Función para cargar preferencias guardadas
            function loadSavedFontSize() {
                try {
                    const savedLevel = localStorage.getItem('airport-font-level');
                    if (savedLevel !== null) {
                        currentFontLevel = parseInt(savedLevel);
                        applyFontSize();
                    }
                } catch(e) {
                    // localStorage no disponible, usar valores por defecto
                }
            }

            // Event listeners para los botones
            $('#increase-font').click(function() {
                if (currentFontLevel < maxFontLevel) {
                    currentFontLevel++;
                    applyFontSize();
                }
            });

            $('#decrease-font').click(function() {
                if (currentFontLevel > minFontLevel) {
                    currentFontLevel--;
                    applyFontSize();
                }
            });

            $('#reset-font').click(function() {
                currentFontLevel = 0;
                applyFontSize();
            });

            // Atajos de teclado para accesibilidad
            $(document).keydown(function(e) {
                // Ctrl + Plus para aumentar
                if (e.ctrlKey && (e.key === '+' || e.key === '=')) {
                    e.preventDefault();
                    $('#increase-font').click();
                }
                // Ctrl + Minus para disminuir
                else if (e.ctrlKey && e.key === '-') {
                    e.preventDefault();
                    $('#decrease-font').click();
                }
                // Ctrl + 0 para reset
                else if (e.ctrlKey && e.key === '0') {
                    e.preventDefault();
                    $('#reset-font').click();
                }
            });

            // Cargar configuración guardada al inicializar
            loadSavedFontSize();

            // Actualizar indicador inicial
            updateIndicator();

            // Animación suave para los botones
            $('.font-btn').hover(
                function() {
                    $(this).css('transform', 'scale(1.05)');
                },
                function() {
                    $(this).css('transform', 'scale(1)');
                }
            );
</script>
