    <style type="text/css">
    .slider-container_aifa {
        width: 100%;
        max-width: 100%;
        position: relative;
        overflow: hidden;
        padding: 20px;
    }

    .slider_aifa {
        display: flex;
        transition: transform 0.5s ease-in-out;
        cursor: grab;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        width: 100%;
    }

    .slider_aifa.dragging_aifa {
        cursor: grabbing;
        transition: none;
    }

    .slide_aifa {
        min-width: calc(40% - 20px);
        /* 2.5 slides para desktop */
        margin: 0 10px;
        position: relative;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        user-select: none;
        transition: transform 0.3s ease;
        cursor: pointer;
        /*background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0.9) 100%);*/
        /*background: linear-gradient(to top, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.7), transparent);*/
        background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.3) 50%, transparent 100%);
    }

    .slide_aifa:hover {
        /*transform: scale(1.05);*/
    }

    .slide_aifa:hover img {
        transform: scale(1.05);
    }

    /*.slide_aifa::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%;*/
    /* Ajusta la altura según tus necesidades */
    /* background-color: rgba(0, 27, 44, 0.6);*/
    /* Gris casi transparente */
    /*z-index: 1;*/
    /* Asegura que el div esté por encima de la imagen */
    /*}*/

    /* Media query para móviles */
    @media (max-width: 768px) {
        .slide_aifa {
            min-width: calc(100% - 20px);
            /* 1 slide para móvil */
        }
    }

    .slide_aifa img {
        width: 100%;
        height: 400px;
        object-fit: cover;
        transition: transform 0.3s ease-in-out;
        pointer-events: none;
    }

    /* Ajustar altura de imagen para móviles */
    @media (max-width: 768px) {
        .slide_aifa img {
            height: 300px;
        }
    }

    /*.slide_aifa:hover img {
        transform: scale(1.05);
    }*/

    .overlay_aifa {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        /*background: rgba(0, 0, 0, 0.3);*/
        background-color: rgba(0, 0, 0, 0);
        /*transform: scale(0);*/
        transition: transform 0.3s ease-out;
        /*transform-origin: center;*/
    }

    .slide_aifa:hover .overlay_aifa {
        /*transform: scale(1);*/
        background-color: rgba(0, 0, 0, 0.7);

    }

    .slide-content_aifa {
        /*position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px;
        color: white;
        z-index: 2;
        transition: transform 0.3s ease-in-out;*/
        /*background-color: rgba(0, 27, 44, 0.6);*/
        /*background-color: rgba(0, 27, 44, 0.6);
        background: transparent;
        bottom: -40px;*/
        position: absolute;
        bottom: 0;
        color: #ffffff;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.7), transparent);
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        z-index: 2;
        transition: transform 0.5s ease-in-out, background 0.5s ease;
    }

    .slide_aifa:hover .slide-content_aifa {
        /*transform: translateY(-50px);*/
        /*background: transparent;*/
        background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 80%, transparent);
        transform: translateY(0);
        /* Quitamos el -50px para que el texto crezca hacia arriba naturalmente */
    }

    .slide-title_aifa {
        /*color: white;
        font-size: clamp(1rem, 1.4rem, 1.6rem);
        margin-bottom: 10px;
        display: block;
        position: relative;
        z-index: 3;
        text-decoration: underline;
        text-decoration-color: white;
        text-shadow: 2px 2px 7px #000 !important;
        transition: color 0.3s ease, text-decoration-color 0.3s ease;
        font-weight: 700;*/
        color: white;
        font-size: clamp(1rem, 1.5rem, 2rem);
        font-weight: bold;
        margin: 0 0 12px 0;
        line-height: 1.3;
    }

    /* Ajustar tamaño de título para móviles */
    @media (max-width: 768px) {
        .project-news .projects-bg {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 0;
            width: 100%;
            /*min-height: 514px;*/
        }

        .slide-description_aifa {
            /*font-size: .9rem;
            opacity: 1;
            margin-bottom: 20px;
            position: relative;
            z-index: 3;
            font-weight: 400;*/
        }
    }

    .slide-title_aifa:hover {
        color: #017a61;
        text-decoration-color: #017a61;
        text-decoration: none;
    }

    .slide-description_aifa {
        /*font-size: clamp(0.9rem, 1rem, 1.2rem);
        opacity: 1;
        margin-bottom: clamp(.9rem, 1rem, 1.2rem);
        position: relative;
        z-index: 3;
        font-weight: 400;*/
        color: rgba(255, 255, 255, 0.9);
        font-size: clamp(0.8rem, 1rem, 1.2rem);
        line-height: 1.5;
        margin: 0;
        max-height: 0;
        /* Cerrado por defecto */
        overflow: hidden;
        transition: max-height 0.5s ease;
        /* Transición más suave */
        z-index: 3;
    }

    .slide_aifa:hover .slide-description_aifa {
        /*max-height: 80px;*/
        max-height: 500px;
        /* Un valor alto para que nunca se corte */
        margin-bottom: 15px;
        /* Crea el espacio para el botón "Ver más" */
    }

    .see-more_aifa {
        display: inline-block;
        text-decoration: none;
        color: #66b292;
        font-size: 14px;
        font-weight: 500;
        position: relative;
        opacity: 1;
        transform: translateY(0);
        transition: all 0.3s ease;
        z-index: 3;
        align-self: flex-start;
    }

    .slide_aifa:hover .see-more_aifa {
        opacity: 1;
        transform: translateY(0);
    }

    .see-more_aifa::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 50%;
        width: 0;
        height: 2px;
        background: #66b292;
        transition: all 0.3s ease;
        transform: translateX(-50%);
    }

    .see-more_aifa:hover::after {
        width: 100%;
    }

    .see-more_aifa:hover {
        color: white;
    }

    .slider-buttons_aifa {
        display: none !important;
        position: relative;
        width: 100%;
        display: flex;
        justify-content: space-around;
        gap: 20px;
        padding-bottom: 25px;
        z-index: 10;
    }

    .slider-button_aifa {
        background: rgba(255, 255, 255, 0.8);
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #333;
        transition: background-color 0.3s;
        pointer-events: auto;
    }

    .slider-button_aifa:hover {
        background: white;
    }

    .slide-content_aifa a {
        color: white !important;
        text-decoration: none !important;
        /* Opcional: quita el subrayado del enlace */
    }

    .slide-content_aifa a:visited,
    .slide-content_aifa a:hover,
    .slide-content_aifa a:active,
    .slide-content_aifa a:focus {
        color: white !important;
    }

    #video1 .container {
        padding: 0 15px;
    }

    .uk-card-body {
        padding: 0px !important;
    }

    .uk-card-title {
        font-size: 2.8rem !important;
    }

    .uk-card-title p {
        margin: 15px 0;
    }

    .uk-card-title p:last-child {
        font-size: 1rem;
    }

    @media (max-width: 480px) {
        .uk-card-title {
            font-size: 2.2rem !important;
        }

        #video1 .container {
            padding: 0 30px;
        }

        .counter-item .counter__icon {
            max-width: 48px;
        }
    }

    @media (max-width: 992px) {
        .counter-item .infodato h4 {
            font-size: 2.5rem;
        }
    }

    .slider_aifa::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        background: transparent;
    }

    .slider_aifa::-webkit-scrollbar-thumb {
        background-color: white;
        border-radius: 4px;
    }

    .slider_aifa {
        scrollbar-color: white transparent;
        scrollbar-width: thin;
    }
</style>
    <style type="text/css">
.project-news {
    margin-bottom: 0px !important;
}

.carrusel-container {
    display: flex;
    width: 100%;
    height: 40vh;
    margin-top: 3rem;
}

.carrusel-imagen {
    position: relative;
    width: 80%;
    height: 100%;
}

.imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/*.imagen::after,
.imagen-vertical::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 49%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1;
}*/

/*.imagen-vertical::after {
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
}*/

.texto-carrusel {
    position: absolute;
    bottom: 10%;
    left: 5%;
    color: white;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    width: 60%;
    z-index: 3;
}

.botones {
    position: absolute;
    top: 50%;
    width: 100%;
    display: flex;
    justify-content: space-around;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: none !important;
}

.boton-prev,
.boton-next {
    background: rgba(0, 0, 0, 0);
    color: #fff;
    border: none;
    padding: 20px;
    font-size: 100px;
    cursor: pointer;
    border-radius: 10px;
    width: 50px;
    height: 50px;
}

.carrusel-imagen:hover .botones {
    opacity: 1;
}

.carrusel-vertical {
    display: flex;
    flex-direction: column;
    margin-left: 20px;
    width: 20%;
    height: 100%;
    overflow-y: auto;
    margin-top: 5px;
}

.imagen-vertical {
    position: relative;
    margin-bottom: 10px;
    cursor: pointer;
    text-align: center;
    height: calc(40vh / 3 - 10px);
    background-color: rgba(0, 0, 0, 0.5);
    transition: background-color 0.3s ease, opacity 0.3s ease;
}

.imagen-vertical img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s ease;
}

.imagen-vertical img:hover {
    opacity: 1;
}

.imagen-vertical h3 {
    display: flex;
    position: absolute;
    left: 130px;
    width: 60%;
    padding: 5px 0;
    color: white;
    font-size: 20px;
    text-align: center;
    z-index: 2;
    justify-content: center;
    align-items: center;
    height: 100%;
    display: none;
}

.carrusel-imagen .imagen {
    height: 100%;
    transition: opacity 0.5s ease-in-out;
    opacity: 0;
}

.carrusel-imagen .imagen.visible {
    opacity: 1;
}

.titulo-formal {
    font-family: 'Georgia', serif;
    font-size: 30px;
    font-weight: bold;
    color: white;
    margin-bottom: 8px;
    display: none;
}

.titulo-formal-vertical {
    font-family: 'Georgia', serif;
    font-size: 12px;
    font-weight: bold;
    color: white;
    margin-bottom: 8px;
    display: none !important;
}

.resumen-formal {
    font-family: 'Arial', sans-serif;
    font-size: 20px;
    color: white;
    line-height: 1.5;
}

.carrusel-imagen .imagen img {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    max-height: 40vh;
}
/* Responsividad */

/* Pantallas medianas (tabletas) */
@media (max-width: 768px) {
    .carrusel-imagen .imagen img {
        object-fit: contain !important;
    }
    .imagen-vertical img {
        object-fit: fill;
    }
    .carrusel-vertical {
        flex-direction: row; /* Mantén el carrusel vertical en una fila para pantallas grandes */
        width: 100%; /* Asegura que ocupe todo el ancho */
        margin-left: -130px;
        overflow-x: auto;
        overflow-y: hidden;
        height: auto;
    }
    .carrusel-container {
        flex-direction: column; /* Coloca el carrusel principal encima */
        height: auto; /* Deja que el contenedor se ajuste a la altura */
        margin-top: 1.5rem; /* Ajusta el margen superior */
    }

    .carrusel-imagen {
        width: 100%; /* Asegúrate de que ocupe el 100% del espacio disponible */
        height: 100%; /* Ajusta el carrusel principal */
    }

    .carrusel-vertical {
        flex-direction: column; /* Coloca las imágenes verticales debajo del carrusel principal */
        width: 100%; /* Asegúrate de que el carrusel vertical ocupe todo el ancho */
        height: auto; /* Deja que se ajuste al contenido */
        margin-top: 20px; /* Espacio entre el carrusel principal y el vertical */
    }

    .imagen-vertical {
        height: auto; /* Ajuste de altura para las imágenes verticales */
        width: 100%; /* Asegura que las imágenes verticales ocupen todo el ancho */
        margin-bottom: 10px; /* Espacio entre las imágenes */
    }

    .imagen-vertical h3 {
        display: flex;
        position: absolute;
        left: 0; /* Ajusta la posición del título para tabletas */
        width: 100%;
        padding: 5px 0;
        color: white;
        font-size: 16px; /* Ajuste del tamaño del texto */
        text-align: center;
        z-index: 2;
        justify-content: center;
        align-items: center;
        height: 100%;
        display: none;
    }
}

/* Ajustes para pantallas grandes (hasta 1024px) */
@media (max-width: 1024px) {
    .carrusel-imagen .imagen img {
        object-fit: contain !important;
    }
    .imagen-vertical img {
        object-fit: fill;
    }
    .carrusel-container {
        flex-direction: column; /* Coloca el carrusel principal encima */
        height: auto; /* Ajusta el contenedor */
    }

    .carrusel-imagen {
        width: 100%; /* Asegura que el carrusel principal ocupe el 100% */
    }

    .carrusel-vertical {
        flex-direction: row; /* Mantén el carrusel vertical en una fila para pantallas grandes */
        width: 100%; /* Asegura que ocupe todo el ancho */
        margin-left: 0;
        overflow-x: auto;
        overflow-y: hidden;
        height: auto;
    }

    .imagen-vertical {
        width: calc(100% / 3); /* Ajusta el ancho de las imágenes para que se distribuyan en 3 columnas */
        height: calc(40vh / 3 - 10px); /* Ajusta la altura de las imágenes */
        margin: 0 5px; /* Agrega márgenes entre las imágenes */
    }

    .titulo-formal {
        font-size: 20px; /* Ajuste del tamaño de fuente */
        display: none;
    }

    .resumen-formal {
        font-size: 14px; /* Ajuste del tamaño de la fuente */
    }

    .imagen-vertical h3 {
        font-size: 18px; /* Ajuste del tamaño del texto */
        display: none;
    }
}

/* Ajustes para pantallas pequeñas (teléfonos) */
@media (max-width: 480px) {
    .carrusel-vertical {
        flex-direction: row; /* Mantén el carrusel vertical en una fila para pantallas grandes */
        width: 100%; /* Asegura que ocupe todo el ancho */
        margin-left: 0;
        overflow-x: auto;
        overflow-y: hidden;
        height: auto;
    }
    .titulo-formal {
        font-size: 16px !important;
        display: none;
    }

    .titulo-formal-vertical {
        font-size: 10px !important;
        display: none;
    }

    .imagen-vertical h3 {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 8px !important;
        width: 90%;
        text-align: center;
        padding: 0;
        display: none;
    }

    .resumen-formal {
        font-size: 12px;
        line-height: 1.2;
    }

    .imagen-vertical {
        width: calc(100% / 2); /* Ajuste para pantallas más pequeñas */
        height: auto;
    }

    .imagen-vertical img {
        opacity: 0.7;
    }
}


/*estadisticas*/
@media (min-width: 480px) {
    .col-md-12 {
        flex: 0 0 auto;
        width: 100%;
    }
}
</style>
