    .overlay-video {
        content: '';
        position: relative;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1;
    }

    .video-heading {
        margin-bottom: 1rem;
        color: #ffffff !important;
    }

    .video-heading p {
        color: #ffffff !important;
    }

    .video-heading h3 {
        color: #ffffff !important;
    }

    .bg-video iframe {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 150vw;
        /* Zoom para eliminar bordes */
        height: 150vh;
        transform: translate(-50%, -50%) scale(1.2);
        /* Scale adicional para zoom */
        pointer-events: none;
        border: none;
    }

    /* Asegurar que el contenido esté por encima del video */
    .container {
        position: relative;
        z-index: 2;
    }

    /* Ajustes adicionales para los contadores */
    .counter-item {
        margin: 1rem;
        overflow-wrap: break-word;
        position: relative;
        z-index: 2;
    }

    .counter-item .counter-icon {
        margin-bottom: 1rem;
    }

    /*====================================================*/
    /*====== HOME - SECCIÓN DE SERVICIOS RELEVANTES ======*/
    /*====================================================*/

    .card-relevantes {
        border: none;
        border-radius: 5px;
        overflow: hidden;
        position: relative;
        height: 500px;
        transition: all 0.4s ease;
    }

    .card-relevantes .card-img-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .card-relevantes .card-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .card-relevantes:hover .card-img-wrapper img {
        transform: scale(1.1);
    }

    .card-relevantes .card-overlay {
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom,
                transparent 0%,
                rgba(0, 27, 44, 0.5) 60%,
                rgba(0, 27, 44, 0.9) 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding: clamp(15px, 20px, 30px);
        /*transition: background 0.3s ease;*/
    }

    .service-item .service__overlay {
        bottom: -150px;
    }

    .service-item .service__img:before {
        background: linear-gradient(to bottom, transparent 0%, rgba(0, 27, 44, 0.5) 60%, rgba(0, 27, 44, 0.9) 100%);
    }

    .card-relevantes:hover .card-overlay {
        /*background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.9));*/
        /*background: linear-gradient(to bottom, rgba(0, 27, 44, 0.1), rgba(0, 27, 44, 0.8)) !important;*/
    }

    .card-relevantes .logo-wrapper {
        display: flex;
        align-items: end;
        justify-content: center;
        width: 44px;
        flex-shrink: 0;
    }

    .card-relevantes .logo-wrapper img {
        width: clamp(1.8rem, 2.2rem, 2.6rem);
        height: auto;
        object-fit: contain;
        filter: brightness(0) invert(1);
        margin-bottom: 0px;
    }

    .card-relevantes .card-title {
        color: #fff;
        font-size: clamp(1.2rem, 1.5rem, 1.8rem);
        font-weight: 700;
    }

    .card-relevantes .card-description {
        color: rgba(255, 255, 255, 0.9);
        font-size: clamp(.8rem, 1rem, 1.2rem);
        line-height: 1.6;
        margin-bottom: clamp(.5rem, 1.5rem, 1.6rem);
        text-align: center;
    }

    .card-title-service {
        display: grid;
        grid-template-columns: 44px 1fr 44px;
        align-items: center;
        min-height: 60px;
        width: 100%;
        padding: 0 8px;
        margin-bottom: clamp(.9rem, 1.5rem, 1.6rem);
        align-content: end;
    }

    .card-title-service::after {
        content: '';
        display: block;
        width: 44px;
    }

    .card-title-service h2 {
        margin-bottom: 0;
        text-align: center;
        font-size: 1.1rem;
    }

    .card-body {
        padding: 25px;
        text-align: center;
    }

    .btn-read-more {
        color: #fff;
        border: none;
        padding: 0.5rem 0;
        font-weight: 600;
        font-size: clamp(0.8rem, 1rem, 1.2rem);
        text-decoration: none;
        display: inline-block;
        transition: all 0.4s ease;
        position: relative;
        overflow: visible;
        background: transparent;
        cursor: pointer;
    }

    .btn-read-more span {
        position: relative;
        z-index: 1;
        color: #fff;
    }

    .btn-read-more::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: #17a697;
        transition: width 0.4s ease;
    }

    .btn-read-more:hover::after,
    .btn-read-more:active::after {
        width: 100%;
    }

    .btn-read-more:hover,
    .btn-read-more:active {
        color: #fff;
        text-decoration: none;
    }

    /* Responsive service__img*/
    @media (max-width: 768px) {
        .card-relevantes {
            height: 350px;
        }
    }

    /* Tablet: cards*/
    @media (min-width: 576px) and (max-width: 991px) {
        .card-title-service {
            grid-template-columns: 32px 1fr 32px;
            padding: 0 4px;
        }

        .card-title-service::after {
            width: 32px;
        }

        .card-relevantes .logo-wrapper {
            width: 32px;
        }

        .card-relevantes .logo-wrapper img {
            width: 1.6rem;
        }

        .card-title-service h2 {
            font-size: 1rem !important;
            margin-left: .5rem;
            margin-right: .5rem;
        }

        .service-item .service__overlay {
            bottom: -220px;
        }
    }

    /*====================================================*/
    /*  ====== AIFA INFORMA - CARRUSEL NOTICIAS ======    */
    /*====================================================*/

    .aifa-carousel-wrapper {
        margin-top: 2rem;
    }

    .carousel-bootstrap {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .carousel-inner {
        position: relative;
        width: 100%;
        overflow: hidden;
        display: block;
        height: auto !important;
    }

    .carousel-item {
        position: relative;
        display: none;
        float: left;
        width: 100%;
        margin-right: -100%;
        backface-visibility: hidden;
        transition: transform .6s ease-in-out;
        height: auto !important;
    }

    .carousel-item.active {
        display: block !important;
    }


    .aifa-carousel-container {
        display: flex;
        gap: 20px;
        align-items: stretch;
        width: 100%;
        height: auto;
    }

    .aifa-main-view {
        flex: 3;
        min-width: 0;
    }


    .aifa-slide-content {
        width: 100%;
        aspect-ratio: 1024 / 383;
        background-color: transparent;
        overflow: hidden;
        border-radius: 8px;
    }

    .aifa-slide-content img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .aifa-slide-content a {
        display: block;
        width: 100%;
        height: auto;
    }

    .aifa-thumbnails {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0 30px;
        overflow-y: auto;
        min-height: 200px;
        height: 0;
    }

    .aifa-thumb-card {
        width: 100%;
        /*aspect-ratio: 16 / 9;*/
        aspect-ratio: 1024 / 383;
        flex-shrink: 0;
        border-radius: 4px;
        overflow: hidden;
        border: 3px solid transparent;
        cursor: pointer;
        transition: all 0.4s ease;
        opacity: 0.5;
        filter: grayscale(30%);
    }

    .aifa-thumb-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .aifa-thumb-card:hover img {
        opacity: 0.9;
        ilter: grayscale(0%);
    }

    .aifa-thumb-card.active {
        /*border-color: #017a61;*/
        opacity: 1 !important;
        filter: grayscale(0%) !important;

    }

    .aifa-thumb-card.active img {
        opacity: 1;
    }

    /* 6. Controles (Flechas) */
    .carousel-control-prev,
    .carousel-control-next {
        z-index: 99 !important;
        pointer-events: auto !important;
        cursor: pointer !important;
        opacity: 0.8;
        background: rgba(0, 0, 0, 0.1);
        width: 50px;
        height: 50px;
        top: 50%;
        transform: translateY(-50%);
        border-radius: 50%;
        margin: 0 10px;
    }

    .carousel-control-prev:hover,
    .carousel-control-next:hover {
        opacity: 1;
        background: rgba(0, 0, 0, 0.3);
    }

    .btn-slide-news {
        background: #017a61;
        border: none;
        color: #fff;
        padding: 8px 20px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        align-content: center;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .btn-slide-news span {
        position: relative;
        z-index: 1;
    }


    .btn-slide-news:hover::before {
        left: 0;
    }

    .btn-slide-news:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(1, 122, 97, 0.2);
        color: #fff;
        background-color: var(--shadow-color-primary);
        border-color: var(--shadow-color-primary);
        text-decoration: none;
    }

    @media (max-width: 992px) {
        .aifa-carousel-container {
            flex-direction: column;
        }

        .aifa-thumbnails {
            flex-direction: row !important;
            height: auto !important;
            min-height: auto !important;
            overflow-x: auto;
        }

        .aifa-thumb-card {
            width: 200px;
            flex: 0 0 200px;
        }
    }

    /*INFORMACIÓN ÚTIL*/
    .services .client h3 {
        font-size: 1.2rem;
    }
</style>
    <style type="text/css">
* {
    box-sizing: border-box;
}
.button-container {
    position: relative;
    width: 200px;
    height: 200px;
    margin-right: 20px;
}
.wayfinding-button {
    position: absolute;
    right: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #017a61;
    border: none;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 14px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
}
.wayfinding-button:nth-child(1) {
    top: 0;
}
.wayfinding-button:nth-child(2) {
    top: 70px;
}
.wayfinding-button:nth-child(3) {
    top: 140px;
}
.wayfinding-button.expanded {
    width: 200px;
    border-radius: 30px;
    justify-content: space-between;
    padding-left: 20px;
    z-index: 10;
}
.button-icon {
    font-style: normal;
    font-size: 24px;
    color: white;
}
.button-text {
    color: white;
    display: none;
    white-space: nowrap;
    font-family: Arial, sans-serif;
    font-size: 16px;
}
.wayfinding-button.expanded .button-text {
    display: inline;
}
.video-background {
    background: #000;
    position: relative;
    z-index: -99;
}
.video-foreground, .video-background iframe {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}
#vidtop-content {
    top: 0;
    color: #fff;
}

/* Media query adjustments */
@media (min-aspect-ratio: 16/9) {
    .video-foreground {
        height: 300%;
        top: -100%;
    }
}

@media (max-aspect-ratio: 16/9) {
    .video-foreground {
        width: 300%;
        left: -100%;
    }
}

/* ... Other CSS rules (cleaned) ... */
.vuelo-banner {
    position: absolute;

    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
}

#services {
    /*margin-top: 80px;*/ /* Ajusta este valor según la altura de tu vuelo-banner */
    position: relative;
    z-index: 0;
}
.vuelo-transport-label img{
    width: 80px !important;
}

.vuelo-transport-option:checked + .vuelo-transport-label {
    background-color: #017a61 !important;
}

@media (min-width: 769px) {
    .vuelo-banner {
        top: -20px;
    }
}
