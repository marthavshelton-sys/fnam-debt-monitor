$(document).ready(function() {
    $('.menu-trigger').on('click', function() {
        if ($(window).width() < 768) {
            const $el = $(this);
            const $target = $(this).next('.dropdown-menu');
            const isOpen = $target.is(':visible');

            $('.dropdown-menu').slideUp(400, function() {
                $(this).removeClass('show').css('display', '');
            });

            if (!isOpen) {
                $target.slideDown(400, function() {
                    $(this).addClass('show').css('display', '');

                    const $nav = $('#mainNavigation');
                    $nav.animate({
                        scrollTop: $nav.scrollTop() + $el.offset().top - $nav.offset().top
                    }, 500);
                });
            }
        } else {
            const $menu = $(this).siblings('.dropdown-menu');
            $('.dropdown-menu').not($menu).removeClass('show');
            $menu.toggleClass('show');
        }
    });

    // Cerrar dropdown si se hace clic fuera
    $(document).on('click', function(event) {
        if (!$('.navbar-collapse').hasClass('menu-opened') && !$(event.target).closest('.nav__item').length) {
            $('.dropdown-menu').removeClass('show').css('display', '');
        }
    });
});

$('.dropdown-menu-col a.subnull').remove();
