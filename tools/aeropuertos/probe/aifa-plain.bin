    * {
        box-sizing: border-box;
    }

    .button-container {
        position: relative;
        width: 200px;
        height: 200px;
        margin-right: 20px;
    }

    .wayfinding-button {
        position: absolute;
        right: 0;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #017a61;
        border: none;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 14px;
        overflow: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .wayfinding-button:nth-child(1) {
        top: 0;
    }

    .wayfinding-button:nth-child(2) {
        top: 70px;
    }

    .wayfinding-button:nth-child(3) {
        top: 140px;
    }

    .wayfinding-button.expanded {
        width: 200px;
        border-radius: 30px;
        justify-content: space-between;
        padding-left: 20px;
        z-index: 10;
    }

    .button-icon {
        font-style: normal;
        font-size: 24px;
        color: white;
    }

    .button-text {
        color: white;
        display: none;
        white-space: nowrap;
        font-family: Arial, sans-serif;
        font-size: 16px;
    }

    .section_cards_title {
        color: white;
        font-size: 2.8rem !important;
        font-weight: 700;
        padding-left: 1.7rem;
    }

    .slide-left {
        animation: slideLeft 0.3s ease-out;
        padding-left: 20px;
        margin: 0 10px;

    }

    @keyframes slideLeft {
        from {
            opacity: 0;
            transform: translateX(300px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .card-news-overlay {
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom,
                transparent 0%,
                rgba(0, 27, 44, 0.3) 60%,
                rgba(0, 27, 44, 0.6) 100%);
    }

    .section_card_title_center {
        color: #000;
        font-size: 2.8rem !important;
        font-weight: 700;
        display: flow-root !important;
    }

    .heading-center {
        text-align: center !important;
    }

    .divider__theme::after {
        width: 40px !important;
    }

    .slide-right {
        animation: slideRight 0.3s ease-out;
    }

    @keyframes slideRight {
        from {
            opacity: 0;
            transform: translateX(-300px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .wayfinding-button.expanded .button-text {
        display: inline;

        .video-background {
            background: #000;
            position: relative;
            z-index: -99;
        }

        .video-foreground,
        .video-background iframe {
            position: relative;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        #vidtop-content {
            top: 0;
            color: #fff;
        }

        @media(min-aspect-ratio: 16/9) {
            .video-foreground {
                height: 300%;
                top: -100%;
            }
        }

        @media(max-aspect-ratio: 16/9) {
            .video-foreground {
                width: 300%;
                left: -100%;
            }
        }
    }


