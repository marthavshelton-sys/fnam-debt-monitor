    <style type="text/css">
    /* --- Estilos Generales y Layout --- */
    .header {
        position: absolute !important;
        z-index: 1010;
        width: 100% !important;
    }

    #HomeSlider {
        height: 100vh;
        display: grid;
        /*place-items: center;*/
        overflow: hidden;
    }

    video {
        overflow: auto;
        object-fit: cover;
        width: 100%;
        height: 100%;
        position: absolute;
        border-radius: 0px;
    }

    main {
        position: relative;
        width: 100%;
        height: 100%;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
    }

    /* --- Animaciones y Clases de Entrada --- */
    .home-b {
        font-size: 4.6666rem !important;
        /*padding-left: 20% !important;*/
        animation: slideIn 2s ease-out forwards;
        opacity: 0;
    }

    .conoceaifa {
        animation: slideder 2s ease-out forwards;
        opacity: 0;
    }

    .aifainforma {
        animation: slideIn2 2s ease-out forwards;
        opacity: 0;
    }

    @keyframes slideIn {
        0% {
            transform: translateX(-100%);
            opacity: 0;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes slideIn2 {
        0% {
            transform: translateX(-100%);
            opacity: 0;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes slideder {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }

        50% {
            opacity: 0.5;
        }

        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes show {
        0% {
            filter: blur(5px);
            transform: translateY(calc(-50% + 75px));
        }

        100% {
            opacity: 1;
            filter: blur(0);
        }
    }

    /* --- Items del Slider --- */
    .item {
        width: 200px;
        height: 300px;
        list-style-type: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
        background-position: center;
        background-size: cover;
        border-radius: 20px;
        transition: transform 0.1s, left 0.75s, top 0.75s, width 0.75s, height 0.75s;
    }

    .item:nth-child(1),
    .item:nth-child(2) {
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        transform: none;
        border-radius: 0;
        box-shadow: none;
        opacity: 1;
    }

    .item:nth-child(3) {
        left: 50%;
    }

    .item:nth-child(4) {
        left: calc(50% + 220px);
    }

    .item:nth-child(5) {
        left: calc(50% + 440px);
    }

    .item:nth-child(6) {
        left: calc(50% + 660px);
        opacity: 0;
    }

    /* --- Contenido de los Items --- */
    .content {
        width: min(30vw, 400px);
        position: absolute;
        top: 50%;
        left: 3rem;
        transform: translateY(-50%);
        font: 400 0.85rem helvetica, sans-serif;
        color: white;
        text-shadow: 0 3px 8px rgba(0, 0, 0, 0.5);
        display: block;
    }

    .content .description {
        line-height: 1.7;
        margin: 1rem 0 1.5rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .content button {
        width: fit-content;
        background-color: rgba(0, 0, 0, 0.1);
        color: white;
        border: 2px solid white;
        border-radius: 0.25rem;
        padding: 0.75rem;
        cursor: pointer;
    }

    h2.title {
        color: white;
        font-weight: bold;
        text-shadow: 2px 2px 7px #000 !important;
    }

    h1.title {
        color: white;
        font-weight: bold;
        text-shadow: 2px 2px 7px #000 !important;
    }

    .item:nth-of-type(2) .content {
        display: block;
        animation: show 0.75s ease-in-out 0.3s forwards;
    }

    /* --- Navegación --- */
    .navi {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 5;
        user-select: none;
    }

    .navi .btn {
        background-color: rgba(255, 255, 255, 0.5);
        color: rgba(0, 0, 0, 0.7);
        border: 2px solid rgba(0, 0, 0, 0.6);
        margin: 0 6.25rem;
        padding: 0.75rem;
        border-radius: 50%;
        cursor: pointer;
        z-index: 20;
    }

    .navi .btn:hover {
        background-color: rgba(255, 255, 255, 0.3);
    }

    /* --- Media Queries Desktop --- */
    @media (min-width: 1601px) {
        .header__top-right {
            position: static;
            margin-bottom: -10px !important;
        }
    }

    @media (min-width: 1250px) {
        .header__top-right {
            position: static !important;
            margin-bottom: -15px !important;
        }
    }

    /* --- Media Queries Tablets y Mobile --- */
    @media (max-width: 900px) and (min-width: 651px) {
        .content .title {
            font-size: 1rem;
        }

        .content .description,
        .content button {
            font-size: 0.7rem;
        }

        .item {
            width: 160px;
            height: 270px;
        }

        .item:nth-child(4) {
            left: calc(50% + 170px);
        }

        .item:nth-child(5) {
            left: calc(50% + 340px);
        }

        .item:nth-child(6) {
            left: calc(50% + 510px);
        }
    }

    @media (max-width: 650px) {
        .content {
            width: min(48vw, 200px);
            left: 4rem;
            text-align: left;
        }

        .content .title {
            font-size: 2.3rem !important;
        }

        .content .description {
            font-size: 0.65rem;
        }

        .item {
            width: 130px;
            height: 220px;
        }

        .item:nth-child(4) {
            left: calc(50% + 140px);
        }

        .item:nth-child(5) {
            left: calc(50% + 280px);
        }

        .item:nth-child(6) {
            left: calc(50% + 420px);
        }

        .vuelo-banner {
            position: absolute;
            top: -210px !important;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1;
        }
    }

    @media (max-width: 500px) {
        .navi {
            display: none;
        }
    }

    /* Estilos de búsqueda de vuelos (Consolidados) */
    .vuelo-search-container {
        width: 100%;
        z-index: 1001;
    }

    .vuelo-transport-buttons {
        display: flex;
        justify-content: center;
        width: 90%;
        margin: 0 auto;
    }

    .vuelo-transport-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 33.33%;
        cursor: pointer;
        padding: 10px 30px;
        color: white !important;
        background-color: rgba(35, 83, 107, 0.60);
        border-radius: 14px 14px 0 0;
    }

    .vuelo-transport-option:checked+.vuelo-transport-label {
        background-color: rgba(1, 122, 97, 1);
    }

    .vuelo-search-row {
        background: linear-gradient(180deg, rgba(35, 83, 107, 1) 0%, rgba(26, 66, 87, 1) 35%, rgba(9, 33, 47, 1) 100%);
        padding: 1.5rem;
        border-radius: 10px;
    }


