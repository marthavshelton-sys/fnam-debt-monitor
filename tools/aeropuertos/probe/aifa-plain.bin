    .project-item .project__desc {
        font-weight: bold;
    }

    /*-----------------------
    project-news
------------------------*/
    .project-news .projects-bg {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        /*min-height: 664px;*/
    }

    .project-news {
        position: relative;
        margin-bottom: 30px;
    }

    .project-news .heading__title {
        font-weight: 700;
    }

    .project-news .project__img {
        position: relative;
        -webkit-transition: all 0.6s linear;
        -moz-transition: all 0.6s linear;
        -ms-transition: all 0.6s linear;
        -o-transition: all 0.6s linear;
        transition: all 0.6s linear;
    }

    .project-news .project__img:after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 99%;
        height: 100%;
        opacity: 0.7;
        display: block;
        background-image: -webkit-linear-gradient(top, rgba(0, 0, 0, 0), #1b1a1a 100%);
        background-image: -moz-linear-gradient(top, rgba(0, 0, 0, 0), #1b1a1a 100%);
        background-image: -ms-linear-gradient(top, rgba(0, 0, 0, 0), #1b1a1a 100%);
        background-image: -o-linear-gradient(top, rgba(0, 0, 0, 0), #1b1a1a 100%);
        background-image: linear-gradient(top, rgba(0, 0, 0, 0), #1b1a1a 100%);
        -webkit-transition: all 0.4s linear;
        -moz-transition: all 0.4s linear;
        -ms-transition: all 0.4s linear;
        -o-transition: all 0.4s linear;
        transition: all 0.4s linear;
        -webkit-transform: scale(0);
        -moz-transform: scale(0);
        -ms-transform: scale(0);
        -o-transform: scale(0);
        transform: scale(0);
    }

    .project-news .project__img img {
        width: 100%;
    }

    .project-news .project__content {
        padding: 30px;
        background-color: #ffffff;
    }

    .project-news .project-item {
        box-shadow: none;
        overflow: hidden;
    }

    .project-news .project-item .project__content {
        background-color: transparent;
        position: absolute;
        top: -20px;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .project-news .project-item .project__cat {
        background-color: #017a61;
        display: inline-block;
        padding: 7px 9px;
        border-radius: 2px;
    }

    .project-news .project__cat {
        line-height: 1;
        margin-bottom: 11px;
    }

    .project-news .project__cat a {
        position: relative;
        font-family: "Roboto", sans-serif;
        font-size: 13px;
        color: #017a61;
        padding-right: 7px;
    }

    .project-news .project-item .btn__link {
        margin-top: 20px;
        padding-bottom: 5px;
        opacity: 0;
        -webkit-transition: all 0.6s linear;
        -moz-transition: all 0.6s linear;
        -ms-transition: all 0.6s linear;
        -o-transition: all 0.6s linear;
