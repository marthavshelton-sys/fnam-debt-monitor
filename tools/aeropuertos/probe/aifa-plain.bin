    document.addEventListener('DOMContentLoaded', function() {
        const carouselElement = document.getElementById('carouselAifa');
        const mainView = document.querySelector('.aifa-main-view');
        const thumbColumn = document.querySelector('.aifa-thumbnails');
        const mainImg = document.querySelector('.aifa-slide-content img');

        var carouselInstance = new bootstrap.Carousel(carouselElement, {
            interval: 5000,
            pause: 'hover'
        });

        function adjustColumnHeight() {
            if (window.innerWidth > 992) {
                const alturaReal = mainView.offsetHeight || mainImg.clientHeight;
                if (alturaReal > 50) {
                    thumbColumn.style.setProperty('height', alturaReal + "px", 'important');
                }
            } else {
                thumbColumn.style.height = "auto";
            }
        }

        adjustColumnHeight();
        window.addEventListener('load', adjustColumnHeight);
        window.addEventListener('resize', adjustColumnHeight);

        if (mainImg && mainImg.complete) {
            adjustColumnHeight();
        } else if (mainImg) {
            mainImg.onload = adjustColumnHeight;
        }

        const btnNext = document.getElementById('btn-next') || document.querySelector('.carousel-control-next');
        const btnPrev = document.getElementById('btn-prev') || document.querySelector('.carousel-control-prev');

        if (btnNext) {
            btnNext.addEventListener('click', function(e) {
                e.preventDefault();
                carouselInstance.next();
            });
        }

        if (btnPrev) {
            btnPrev.addEventListener('click', function(e) {
                e.preventDefault();
                carouselInstance.prev();
            });
        }

        document.querySelectorAll('.aifa-thumb-card').forEach(thumb => {
            thumb.addEventListener('click', function() {
                const index = parseInt(this.getAttribute('data-slide-to'));
                carouselInstance.to(index);
            });
        });

        carouselElement.addEventListener('slid.bs.carousel', function(e) {
            adjustColumnHeight();

            document.querySelectorAll('.aifa-thumb-card').forEach(t => t.classList.remove('active'));
            const activeThumb = document.querySelector(`.aifa-thumb-card[data-slide-to="${e.to}"]`);

            if (activeThumb) {
                activeThumb.classList.add('active');

                const container = thumbColumn;

                const thumbTop = activeThumb.offsetTop;
                const thumbHeight = activeThumb.offsetHeight;
                const containerHeight = container.offsetHeight;
                const containerScroll = container.scrollTop;

                if (thumbTop < containerScroll) {
                    container.scrollTo({
                        top: thumbTop,
                        behavior: 'smooth'
                    });
                } else if (thumbTop + thumbHeight > containerScroll + containerHeight) {
                    container.scrollTo({
                        top: thumbTop - containerHeight + thumbHeight,
                        behavior: 'smooth'
                    });
                }
            }
        });
    });
</script>
