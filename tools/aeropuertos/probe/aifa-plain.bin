(function () {
    var videos = document.querySelectorAll('video[data-lazy-video]');
    if (!videos.length) return;

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var video = entry.target;
            var source = video.querySelector('source[data-src]');
            if (source) {
                source.src = source.getAttribute('data-src');
                source.removeAttribute('data-src');
                video.load();
                video.play().catch(function () {});
            }
            observer.unobserve(video);
        });
    }, { rootMargin: '0px 0px 200px 0px' });

    videos.forEach(function (video) {
        observer.observe(video);
    });
})();
</script>
    <script>
    function checkTextOverflow() {
        const nav = document.querySelector('.navbar-nav');
        const navStyle = window.getComputedStyle(nav);

        const isVertical = navStyle.flexDirection === 'column';

        if (isVertical) {
            nav.classList.add('is-vertical');
        } else {
            nav.classList.remove('is-vertical');
        }

        document.querySelectorAll('.nav__item-link').forEach(link => {
            if (!isVertical && link.scrollWidth > link.clientWidth) {
                link.classList.add('has-overflow');
                link.style.setProperty('--overflow-amount', `-${link.scrollWidth - link.clientWidth}px`);
            } else {
                link.classList.remove('has-overflow');
                link.style.removeProperty('--overflow-amount');
            }
        });
    }

    window.addEventListener('load', checkTextOverflow);
    window.addEventListener('resize', checkTextOverflow);

