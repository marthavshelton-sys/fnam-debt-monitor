# Cloudflare Pages custom headers — https://developers.cloudflare.com/pages/configuration/headers/
# data.js/monthly-data.js change underneath the same URL every day (daily commit / monthly PR
# merge), but a plain <script src="data.js"> tag has no cache-busting query string, so browsers
# and Cloudflare's edge cache could otherwise keep serving a stale copy for hours after a fresh
# commit — directly undermining the "always current" point of the live-data pipeline. Forcing
# revalidation on every request keeps the JS payload tiny (still cached, just re-checked) while
# guaranteeing visitors always get the latest committed values.
/fiscal/data.js
  Cache-Control: no-store

/fiscal/monthly-data.js
  Cache-Control: no-store

# GAP model data files are refreshed daily / after each release under the same URLs.
/gap/data/*
  Cache-Control: no-store

# ASUR and OMA model data files: same daily-refresh pattern as /gap/.
/asur/data/*
  Cache-Control: no-store

/oma/data/*
  Cache-Control: no-store

# Quálitas model data files: same daily / after-each-report refresh under fixed URLs.
/qualitas/data/*
  Cache-Control: no-store

# Gentera model data files: same daily / after-each-report refresh under fixed URLs.
/gentera/data/*
  Cache-Control: no-store

# Oracle model data files: same daily / after-each-release refresh under fixed URLs.
/oracle/data/*
  Cache-Control: no-store

# Mexico fiscal monitor: data.js is committed every business day, docs-data.js by a weekly PR.
/mx/fiscal/data.js
  Cache-Control: no-store

/mx/fiscal/docs-data.js
  Cache-Control: no-store

# Airports hub and airline dashboard: these data files are rewritten daily by workflows under fixed URLs. no-store, as for
# the other dashboards: the zone's Browser Cache TTL (4 h) overrides a max-age=0 from the origin, but never caches no-store.
# The base maps (map.js, map-wide.js) are static and stay cacheable.
/aeropuertos/data/airlines.js
  Cache-Control: no-store

/aeropuertos/data/routes.js
  Cache-Control: no-store

/aeropuertos/data/airlines-summary.js
  Cache-Control: no-store

/aeropuertos/data/traffic.js
  Cache-Control: no-store

/aeropuertos/data/summary.js
  Cache-Control: no-store

/aeropuertos/data/status.js
  Cache-Control: no-store

# Hyperscaler Hub: data files, CSVs, the shared script and style and each page's script change under fixed URLs with every
# refresh (twice a day) and every page change. no-store, like the other dashboards (the zone's 4-hour Browser Cache TTL
# would otherwise let a returning reader run an old build with an old "last refreshed" stamp). The base map
# (assets/map-data.js) is static and stays cacheable.
/hiperescaladores/data/*
  Cache-Control: no-store

/hiperescaladores/:module/data/*
  Cache-Control: no-store

/hiperescaladores/csv/*
  Cache-Control: no-store

/hiperescaladores/assets/hub.js
  Cache-Control: no-store

/hiperescaladores/assets/hub.css
  Cache-Control: no-store

/hiperescaladores/app.js
  Cache-Control: no-store

/hiperescaladores/:module/app.js
  Cache-Control: no-store

# Hand-curated tariffs table: edited with the page, so it must never outlive the page in a cache.
/aeropuertos/data/regulation.js
  Cache-Control: no-store

# Data-refresh watchdog verdicts (.github/workflows/data-watchdog.yml): rewritten hourly when something
# changes; the landing page and the company pages must never read a cached copy.
/status/*
  Cache-Control: no-store

# Cloudflare Pages sends Access-Control-Allow-Origin: * on every response by default, which lets any other site's
# scripts read these files (the status file, data files). Every reader is a page on this same origin, so drop it
# (last line of the block below).
# Security headers on every response (the gate middleware, functions/_middleware.js, sets the same set on the
# responses it builds: the login form, redirects, robots.txt). HSTS one year with subdomains; a Content-Security-Policy
# that allows only this origin, inline scripts and styles (every page composes its markup in-page), Google Fonts, data:
# icons, blob: for the PDFs the decks build in the browser and Cloudflare's Web Analytics beacon (drop the two
# insights entries once the beacon is turned off in the Pages project); no framing anywhere (frame-ancestors 'none'
# and X-Frame-Options); browser features the pages never use are switched off (Permissions-Policy).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  ! Access-Control-Allow-Origin

